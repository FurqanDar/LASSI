# Performance bench deck: many-molecule diblock (Example B–derived).
# Larger than characterization smoke; still short (tens of seconds per run
# on a typical cloud VM). Fully pinned seed + flags for determinism.
#
# System: 500 chains × 20 beads (A10-B10), box 200, density ~1.25e-3
# Schedule: PREEQ_STEPS 1e6 + N_STEPS 1e7, 1 cycle (no annealing)
# Seed: 20241024

BOX_SIZE 200

MC_TEMP            1.0
MC_TEMP_RATE       0.0
MC_TEMP_MODE       -1
MC_DELTA_TEMP      0.0
MC_INVERT_TEMP     0
MC_CYCLE_NUM       1
PREEQ_TEMP         1000.0

N_STEPS            10000000
PREEQ_STEPS        1000000

MC_INDENT_MODE     -1
BIAS_INDENT_RADIUS 0.0
BIAS_INDENT_STIFF  0.0
BIAS_KEEP_ON       0
BIAS_COUPLED_TO_TEMP 0

MV_STROT_FREQ      1.0
MV_LOCAL_FREQ      1.0
MV_COLOCAL_FREQ    1.0
MV_MTLOCAL_FREQ    0.5
MV_SNAKE_FREQ      0.5
MV_TRANS_FREQ      0.2
MV_SMCLSTR_FREQ    0.1
MV_CLSTR_FREQ      0.01
MV_PIVOT_FREQ      0.5
MV_BRROT_FREQ      0.0
MV_DBPVT_FREQ      0.2
MV_PR_SMCLSTR      0.0
MV_PR_CLSTR        0.0

STRUCT_FILETYPE 0
STRUCT_FILE     structure.prm
RESTART_FILE    ##DUMMY##
ENERGY_FILE     energy.prm

# Non-zero seed required: RANDOM_SEED 0 would call time(NULL).
RANDOM_SEED 20241024

REPORT_PREFIX       bench_diblock
# Sparse I/O so wall time reflects MC work, not writers.
REPORT_LOG_FREQ     10000000
REPORT_ENERGY_FREQ  0
REPORT_CONFIG_FREQ  0
REPORT_MCMOVE_FREQ  0
REPORT_NETWORK_FREQ 0
REPORT_RDFTOT_FREQ  0
REPORT_COMDEN_FREQ  0
REPORT_CONFIG_MODE  0
ANALYSIS_CLUSTER_MODE 0
