# Characterization smoke deck: single diblock molecule.
# Fully pinned seed + flags (no wall-clock seed; no ambient keyfile defaults).

BOX_SIZE 40

MC_TEMP            1.0
MC_TEMP_RATE       0.0
MC_TEMP_MODE       -1
MC_DELTA_TEMP      0.0
MC_INVERT_TEMP     0
MC_CYCLE_NUM       1
PREEQ_TEMP         1000.0

N_STEPS            2000
PREEQ_STEPS        500

MC_INDENT_MODE     -1
BIAS_INDENT_RADIUS 0.0
BIAS_INDENT_STIFF  0.0
BIAS_KEEP_ON       0
BIAS_COUPLED_TO_TEMP 0

MV_STROT_FREQ      1.0
MV_LOCAL_FREQ      1.0
MV_COLOCAL_FREQ    1.0
MV_MTLOCAL_FREQ    0.5
MV_SNAKE_FREQ      0.5
MV_TRANS_FREQ      0.0
MV_SMCLSTR_FREQ    0.0
MV_CLSTR_FREQ      0.0
MV_PIVOT_FREQ      0.5
MV_BRROT_FREQ      0.0
MV_DBPVT_FREQ      0.0
MV_PR_SMCLSTR      0.0
MV_PR_CLSTR        0.0

STRUCT_FILETYPE 0
STRUCT_FILE     structure.prm
RESTART_FILE    ##DUMMY##
ENERGY_FILE     energy.prm

# Non-zero seed required: RANDOM_SEED 0 would call time(NULL).
RANDOM_SEED 42

REPORT_PREFIX       smoke_single
REPORT_LOG_FREQ     1000
REPORT_ENERGY_FREQ  500
REPORT_CONFIG_FREQ  500
REPORT_MCMOVE_FREQ  500
REPORT_NETWORK_FREQ 0
REPORT_RDFTOT_FREQ  0
REPORT_COMDEN_FREQ  0
REPORT_CONFIG_MODE  0
ANALYSIS_CLUSTER_MODE 0
